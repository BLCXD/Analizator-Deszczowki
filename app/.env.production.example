# Copy to .env, replace every placeholder, and percent-encode the DB password
# inside DATABASE_URL. Keep .env private and outside version control.
# Public hostnames used by Caddy and automatic TLS.
APP_DOMAIN=app.deszczowka.io
API_DOMAIN=api.deszczowka.io
ACME_EMAIL=admin@example.org

POSTGRES_USER=ad_app
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
POSTGRES_DB=ad_db
DATABASE_URL=postgresql://ad_app:replace-this-password@postgres:5432/ad_db

JWT_SECRET=replace-with-at-least-32-random-bytes
DEVICE_SECRET_SALT=replace-with-a-different-random-secret
# Must match the Pi's /var/lib/ad-agent/claim-key; never commit the real value.
DEVICE_CLAIM_KEY=replace-with-the-pi-claim-key
SECRET_KEY=replace-with-another-independent-32-byte-secret
WTF_CSRF_SECRET_KEY=replace-with-another-independent-32-byte-secret

CORS_ORIGINS=https://app.deszczowka.io
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://backend:8000
WS_URL=wss://api.deszczowka.io/api/v1/measurements/ws
FLASK_ENV=production
SESSION_COOKIE_SECURE=true
SESSION_DB_PATH=/data/flask-sessions.sqlite
RATE_LIMIT_DB_PATH=/data/rate-limits.sqlite
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
ENABLE_MOCK_SIMULATOR=false
PUBLIC_APP_URL=https://app.deszczowka.io
SMTP_HOST=smtp
SMTP_PORT=25
SMTP_AUTH=false
SMTP_FROM=reset@deszczowka.io

# Optional NVIDIA NIM integration for AI summaries. Keep the key server-side.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
