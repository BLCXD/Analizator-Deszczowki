DATABASE_URL=postgresql://user:replace-with-url-encoded-password@postgres:5432/ad_db
ADMIN_EMAIL=
POSTGRES_USER=user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ad_db
JWT_SECRET=replace-with-at-least-32-random-characters
DEVICE_SECRET_SALT=replace-with-a-different-random-secret
# Must match the securely provisioned claim key on the Raspberry Pi.
DEVICE_CLAIM_KEY=replace-with-the-pi-claim-key
CORS_ORIGINS=http://localhost:5000
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-another-32-character-random-secret
FLASK_ENV=production
SESSION_COOKIE_SECURE=false
SESSION_DB_PATH=./data/flask-sessions.sqlite
API_BASE_URL=http://backend:8000
WS_URL=ws://localhost:8000/api/v1/measurements/ws
ENABLE_MOCK_SIMULATOR=true
MOCK_RUNNER_URL=http://mock-runner:8090
MOCK_RUNNER_TOKEN=replace-with-a-different-32-character-random-secret
MOCK_INTERVAL_SECONDS=30
# Optional SMTP credentials belong in ignored .env.mail (copy .env.mail.example).
PUBLIC_APP_URL=http://localhost:5000
# Optional NVIDIA NIM integration for user-requested history summaries.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Web Push (VAPID) — generate once with the push key generator, keep stable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
