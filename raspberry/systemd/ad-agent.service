[Unit]
Description=Analizator Deszczówki Raspberry Pi Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ad-agent
Group=ad-agent
SupplementaryGroups=dialout
StateDirectory=ad-agent
StateDirectoryMode=0700
WorkingDirectory=/opt/ad-agent
EnvironmentFile=/etc/ad-agent/ad-agent.env
Environment=DB_PATH=/var/lib/ad-agent/agent.db
ExecStart=/opt/ad-agent/.venv/bin/python /opt/ad-agent/ad_agent/main.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ad-agent
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
