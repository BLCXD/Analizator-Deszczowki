[Unit]
Description=ADE local HTTPS portal reverse proxy
Wants=network-online.target
After=network-online.target ad-agent.service

[Service]
Type=simple
User=caddy
Group=caddy
SupplementaryGroups=ad-agent
EnvironmentFile=/etc/ad-agent/tls.env
ExecStart=/usr/bin/caddy run --config /etc/ad-agent/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy /var/log/caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
